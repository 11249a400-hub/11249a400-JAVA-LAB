class Student implements Comparable<Student> {

    int rollNo;
    String name;

    Student(int rollNo, String name) {
        this.rollNo = rollNo;
        this.name = name;
    }

    // Compare students based on roll number
    @Override
    public int compareTo(Student other) {
        return this.rollNo - other.rollNo;
    }

    void display() {
        System.out.println(rollNo + " - " + name);
    }
}

public class ComparableDemo {

    public static void main(String[] args) {

        Student s1 = new Student(103, "Ravi");
        Student s2 = new Student(101, "Arun");
        Student s3 = new Student(102, "Kiran");

        Student[] students = {s1, s2, s3};

        System.out.println("Before Sorting:");

        for (Student s : students) {
            s.display();
        }

        java.util.Arrays.sort(students);

        System.out.println("\nAfter Sorting by Roll Number:");

        for (Student s : students) {
            s.display();
        }
    }
}

***output***
Before Sorting:
103 - Ravi
101 - Arun
102 - Kiran

After Sorting by Roll Number:
101 - Arun
102 - Kiran
103 - Ravi

